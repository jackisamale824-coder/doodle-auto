{
  "name": "doodlescreed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=output/game-server.mjs",
    "build:app": "vite build --config vite.app.config.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "check:cloudflare": "cf workers types && tsc --noEmit -p tsconfig.cloudflare.json",
    "test:browser": "node scripts/browser-check.mjs",
    "format:check": "prettier --check src server tests scripts index.html"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "better-sqlite3": "11.10.0",
    "jose": "6.2.18",
    "three": "^0.180.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.5.13",
    "cf": "^1.0.0-rc.4",
    "esbuild": "0.25.12",
    "playwright": "^1.58.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.8"
  }
}
