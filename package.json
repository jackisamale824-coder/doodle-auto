{
  "name": "doodlescreed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "test:browser": "node scripts/browser-check.mjs",
    "format:check": "prettier --check src server tests scripts index.html"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "three": "^0.180.0",
    "vite": "^6.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.5.13",
    "playwright": "^1.58.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
